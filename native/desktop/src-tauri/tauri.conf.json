{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibleNow",
  "version": "1.0.0",
  "identifier": "now.vible.app",
  "build": {
    "frontendDist": "../../../dist-native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VibleNow",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#f4f1e9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Reference",
    "shortDescription": "A cinematic visual Bible",
    "longDescription": "Read Scripture in Korean, English, Japanese and Chinese with a reviewed image for every passage.",
    "copyright": "Scripture texts: see Translation & sources in the app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
