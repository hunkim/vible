{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Save share cards, open web links in the browser, and drag or control the frameless reader window, and add the Check for Updates menu item.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:menu:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "macappstore://*"
        }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
