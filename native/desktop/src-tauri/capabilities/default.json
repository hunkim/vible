{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Save share cards, open web links in the browser, and drag or control the frameless reader window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "opener:allow-open-url",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
