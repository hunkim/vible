{
  "name": "vible-native",
  "version": "1.0.0",
  "private": true,
  "description": "Store app shells (Capacitor for iOS/Android, Tauri for macOS/Windows) around the web build in ../dist-native",
  "scripts": {
    "bundle": "node ../build.mjs --target=native",
    "sync": "npm run bundle && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "desktop:dev": "npm run bundle && tauri dev",
    "desktop:build": "npm run bundle && tauri build"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tauri-apps/cli": "2.12.0"
  }
}
